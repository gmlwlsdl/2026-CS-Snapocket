# Database
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Security
SECRET_KEY=<YOUR_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=<ACCESS_TOKEN_EXPIRE_MINUTES>

# Environment
APP_ENV=development

# AI Server
# base URL만 넣어도 코드에서 /v1/infer로 보정됨 (예: http://localhost:18080)
AI_SERVER_URL=http://localhost:18080/v1/infer
# aiops-api의 AIOPS_API_KEY와 동일한 값을 사용
AI_SERVER_API_KEY=
AI_SERVER_TIMEOUT_S=60
